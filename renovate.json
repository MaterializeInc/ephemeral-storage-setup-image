{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>MaterializeInc/renovate-config"],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["kube", "k8s-openapi"],
      "groupName": "kube",
      "separateMajorMinor": false
    }
  ],
  "constraints": {
    "rust": "1.99.1"
  }
}
